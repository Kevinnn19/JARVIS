config/*.local.yaml

# ---- JARVIS runtime artefacts ----
# Local audit log / screenshots / databases live outside the repo by default
# (~/.jarvis, ~/Pictures/JARVIS-Screenshots) but ignore them if redirected here.
logs/
*.log
*.jsonl
jarvis.db
jarvis.db-journal
screenshots/

# ---- Android / Expo (Phase 5) ----
mobile-app/node_modules/
mobile-app/.expo/
mobile-app/dist/
mobile-app/android/.gradle/
mobile-app/ios/Pods/
*.jks
*.keystore

# ---- Editors / OS ----
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
